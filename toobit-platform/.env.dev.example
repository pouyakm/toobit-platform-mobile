# DEV: compose + WireMock simulated exchange. Placeholders are fine.
# Copy to .env (git-ignored). NEVER commit real values. Per-environment templates: .env.dev.example, .env.staging.example, .env.prod.example
# Required secrets are validated at startup (fail-fast); the process refuses to boot if one is missing.

ASPNETCORE_ENVIRONMENT=Development

# --- Postgres / Redis (compose-internal in dev) -----------------------------------------------------------
POSTGRES_USER=toobit
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=toobit
POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=toobit;Username=toobit;Password=change-me-dev-only
REDIS_CONNECTION=redis:6379

# --- Toobit credentials: .NET ONLY. Dev uses the WireMock simulated exchange, so these are placeholders. -----
TOOBIT_API_KEY=dev-placeholder-key
TOOBIT_API_SECRET=dev-placeholder-secret

# --- Auth ---------------------------------------------------------------------------------------------------
# openssl rand -base64 48
JWT_SIGNING_KEY=change-me-dev-only-change-me-dev-only-change-me
# 32 bytes, base64: openssl rand -base64 32   (encrypts user emails at rest)
PII_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars

# --- Internal .NET <-> Python HMAC (openssl rand -hex 32). Same values in both services. ------------------------
INTERNAL_HMAC_KEY_ID=backend-1
INTERNAL_HMAC_KEY=change-me-dev-only-hmac-key
INTERNAL_HMAC_MAX_SKEW_SECONDS=60
BACKEND_SIGNAL_URL=http://api:8080/internal/signals

# --- Option-proxy thresholds (ADR-0001). Required: no defaults in code. -----------------------------------------
SIGNALS_HV_WINDOW=30
SIGNALS_IV_WINDOW=14
SIGNALS_IV_SCALE=1.0
SIGNALS_TENOR_DAYS=7
SIGNALS_RATE=0.0
SIGNALS_Z_WINDOW=48
SIGNALS_Z_ENTRY=1.5
SIGNALS_Z_EXIT=0.4
SIGNALS_RATIO_MIN=0.8
SIGNALS_RATIO_MAX=2.5
SIGNALS_PERIODS_PER_YEAR=8760

# --- Model registry / drift -------------------------------------------------------------------------------------
MODEL_REGISTRY_PATH=/models
ACTIVE_MODEL=
DRIFT_PSI_WARN=0.2
DRIFT_KS_WARN=0.2

# --- Strategy and risk limits (hot-reloadable config; defaults live in appsettings.json). Override here if needed.
# Strategy__MaxNotionalPerSymbol=200
# Strategy__MaxDailyLoss=25
# Strategy__MaxOpenPositions=3
