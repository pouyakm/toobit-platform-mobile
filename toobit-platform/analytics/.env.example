# Analytics service (dev). Copy to .env. Never commit real values.
ANALYTICS_ENV=dev
# HMAC key shared with the .NET backend (both directions). Generate: openssl rand -hex 32
INTERNAL_HMAC_KEY_ID=backend-1
INTERNAL_HMAC_KEY=change-me-dev-only
INTERNAL_HMAC_MAX_SKEW_SECONDS=60
# Where the .NET signal-ingest endpoint lives
BACKEND_SIGNAL_URL=http://api:8080/internal/signals
# Option-proxy thresholds (ADR-0001). No defaults are hardcoded in signals/ code.
SIGNALS_TIMEFRAME=1h
SIGNALS_HV_WINDOW=30
SIGNALS_IV_WINDOW=14
SIGNALS_IV_SCALE=1.0
SIGNALS_TENOR_DAYS=7
SIGNALS_RATE=0.0
SIGNALS_Z_WINDOW=48
SIGNALS_Z_ENTRY=1.5
SIGNALS_Z_EXIT=0.4
SIGNALS_RATIO_MIN=0.8
SIGNALS_RATIO_MAX=2.5
SIGNALS_PERIODS_PER_YEAR=8760
# Model registry
MODEL_REGISTRY_PATH=/models
ACTIVE_MODEL=
# Drift thresholds
DRIFT_PSI_WARN=0.2
DRIFT_KS_WARN=0.2
