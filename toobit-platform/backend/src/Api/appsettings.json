{
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "System.Net.Http": "Warning" } } },
  "AllowedHosts": "*",
  "Toobit": { "BaseUrl": "https://api.toobit.com", "RecvWindowMs": 5000, "Category": "USDT" },
  "Scanner": { "IntervalSeconds": 60, "TopN": 20, "MinQuoteVolume": 1000000, "StaleAfterSeconds": 180 },
  "Executor": { "MaxRateLimitRetries": 4 },
  "Reconciliation": { "IntervalSeconds": 30, "UnknownGraceSeconds": 20, "MaxUnknownRetries": 10 },
  "Pipeline": { "QueueCapacity": 256 },
  "Analytics": { "BaseUrl": "http://analytics:8000" },
  "Jwt": { "Issuer": "toobit-platform", "Audience": "toobit-dashboard", "AccessMinutes": 15 },
  "Internal": { "MaxSkewSeconds": 60 },
  "Retention": { "SignalsDays": 90, "OrderEventsDays": 180, "LogsDays": 30, "RiskEventsDays": 365 },
  "Strategy": {
    "StopLossPct": 0.01, "TakeProfitPct": 0.02, "OrderNotionalUsdt": 50,
    "MaxNotionalPerSymbol": 200, "MaxDailyLoss": 25, "MaxOpenPositions": 3
  }
}
